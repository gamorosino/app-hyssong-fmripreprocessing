#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.

set -e

mkdir -p preproc_bold

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

# Bare "python3" on this image can resolve to a minimal system Python that
# lacks usable locale data and crashes on startup. brainlife's own
# app-fmriprep main script never invokes bare python3 either -- it always
# runs the image's bundled conda Python (that's what actually ran fMRIPrep
# successfully earlier in this same project). Use the same one here.
singularity exec -e docker://nipreps/fmriprep:20.2.3 /usr/local/miniconda/bin/python main.py

[ -z "$(ls -A preproc_bold)" ] && echo "no output produced" && exit 1
exit 0
