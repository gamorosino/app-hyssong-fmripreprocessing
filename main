#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.

set -e

mkdir -p preproc_bold

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

# This resource's shared /mnt/scratch/docker-cache has a corrupted cached
# sandbox extraction for docker://nipreps/fmriprep:20.2.3 (its /etc/passwd
# is unreadable garbage, crashing the container's Python at startup on any
# node sharing that cache -- confirmed identical on two different brainlife
# resources). Reference the same image by digest instead of tag so
# Singularity/Apptainer computes a fresh, distinct cache entry.
singularity exec -e docker://nipreps/fmriprep@sha256:102db5fe8b0a34298f2eb2fd5962ad99ff0a948d258cbf08736fcc1b845cad9f /usr/local/miniconda/bin/python main.py

[ -z "$(ls -A preproc_bold)" ] && echo "no output produced" && exit 1
exit 0
